ld text-neutral-800 hover:bg-neutral-100 dark:border-neutral-600/60 dark:bg-neutral-800/80 dark:text-neutral-100 dark:hover:bg-neutral-800"> 所有专题 </a> <a href="/blog/zh/series/openclaw-practice/" class="rounded-md bg-neutral-50 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100 dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-neutral-800"> OpenClaw 部署与实战 </a><a href="/blog/zh/series/cursor-guide/" class="rounded-md bg-neutral-50 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100 dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-neutral-800"> Cursor 完全指南 </a><a href="/blog/zh/series/cloudflare-bindui/" class="rounded-md bg-neutral-50 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100 dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-neutral-800"> Cloudflare 全家桶实战 </a><a href="/blog/zh/series/docker-practice/" class="rounded-md bg-neutral-50 px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100 dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-neutral-800"> Docker 实战指南 </a> </div> </div>  <a href="/blog/zh/archive/" class="block rounded-md border border-neutral-200/70 bg-white px-3 py-2 text-sm font-semibold text-neutral-800 hover:bg-neutral-50 dark:border-neutral-800/70 dark:bg-neutral-900 dark:text-neutral-100 dark:hover:bg-neutral-800"> 文章归档 </a> </div> </div> </div> <script>
  // Stable handler reference so we don't double-toggle
  function handleAccordionClick(e) {
    var t = e.target;
    if (!(t instanceof Element)) return;
    var trigger = t.closest('[data-accordion-trigger]');
    if (!trigger) return;
    var root = trigger.closest('[data-mobile-panel]');
    if (!root) return;
    var id = trigger.getAttribute('data-accordion-trigger');
    if (!id) return;
    var panel = root.querySelector('[data-accordion-panel="' + id + '"]');
    if (panel) panel.classList.toggle('hidden');
  }

  function initMobileAccordion() {
    var script = document.currentScript;
    var root = script && script.previousElementSibling;
    if (!root || !(root instanceof HTMLElement)) {
      root = document.querySelector('[data-mobile-panel]');
    }
    if (!root) return;

    if (root.getAttribute('data-accordion-initialized') === 'true') return;
    root.setAttribute('data-accordion-initialized', 'true');
    root.addEventListener('click', handleAccordionClick);
  }

  initMobileAccordion();
  document.addEventListener('astro:page-load', initMobileAccordion);
</script> </header> <script>
  function handleMobileToggle() {
    const panel = document.querySelector('[data-mobile-panel]');
    if (panel) panel.classList.toggle('hidden');
  }

  function initMobileMenu() {
    const btn = document.querySelector('[data-mobile-trigger]');
    if (!btn) return;
    btn.removeEventListener('click', handleMobileToggle);
    btn.addEventListener('click', handleMobileToggle);
  }

  initMobileMenu();
  document.addEventListener('DOMContentLoaded', initMobileMenu, { once: true });
  document.addEventListener('astro:page-load', initMobileMenu);
</script> <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-5 md:px-6">   <div data-pagefind-ignore> <section class="mb-6 text-center"> <div class="sr-only"> <h1>比邻 · BetterLink Blog</h1> <h2>知识比邻，成长无间</h2> <p>知识比邻，成长无间 - 涵盖技术开发、AI与智能、数字创作、生活智慧、观察思考、工具箱的知识分享平台</p> </div> </section>     <aside class="mb-6 hidden rounded-2xl border border-amber-200 bg-gradient-to-r from-amber-50 via-white to-sky-50 p-4 text-left shadow-sm dark:border-amber-900/60 dark:from-amber-950/40 dark:via-neutral-950 dark:to-sky-950/30" data-lang-recommendation aria-live="polite"> <div class="flex items-start justify-between gap-3"> <div class="min-w-0 flex-1"> <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-100" data-lang-recommendation-title>
Language recommendation
</p> <p class="mt-1 text-sm leading-6 text-neutral-600 dark:text-neutral-300" data-lang-recommendation-body>
We found a language version that may suit your browser preference better.
</p> <div class="mt-3 flex flex-wrap gap-2" data-lang-recommendation-actions></div> </div> <button type="button" class="shrink-0 rounded-full p-2 text-neutral-400 transition-colors hover:bg-white/80 hover:text-neutral-600 dark:hover:bg-neutral-800 dark:hover:text-neutral-300" data-lang-recommendation-close aria-label="Dismiss language recommendation"> <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path> </svg> </button> </div> </aside> <script>(function(){const targetsJson = "[{\"lang\":\"en\",\"href\":\"/en/\",\"label\":\"English\"},{\"lang\":\"ja\",\"href\":\"/ja/\",\"label\":\"日本語\"}]";
const currentLangJson = "\"zh\"";
const storageKey = "lang-recommendation-dismissed:site-home";

  (() => {
    const root = document.querySelector('[data-lang-recommendation]');
    if (!(root instanceof HTMLElement)) return;

    const closeButton = root.querySelector('[data-lang-recommendation-close]');
    const titleEl = root.querySelector('[data-lang-recommendation-title]');
    const bodyEl = root.querySelector('[data-lang-recommendation-body]');
    const actionsEl = root.querySelector('[data-lang-recommendation-actions]');

    if (!(titleEl instanceof HTMLElement) || !(bodyEl instanceof HTMLElement) || !(actionsEl instanceof HTMLElement)) {
      return;
    }

    const currentLang = JSON.parse(currentLangJson);
    const targets = JSON.parse(targetsJson);

    const copy = {
      zh: {
        title: '检测到你可能更适合其他语言版本',
        body: (label) => `你的浏览器语言更接近 ${label}，可以直接切换到对应版本继续浏览。`,
        cta: (label) => `打开 ${label}`,
      },
      en: {
        title: 'You may prefer another language version',
        body: (label) => `Your browser language looks closer to ${label}. You can switch with one click.`,
        cta: (label) => `Open ${label}`,
      },
      ja: {
        title: 'より適した言語版が見つかりました',
        body: (label) => `ブラウザ設定を見ると ${label} の方が合っていそうです。ワンクリックで切り替えられます。`,
        cta: (label) => `${label} を開く`,
      },
    };

    if (localStorage.getItem(storageKey) === 'true') return;

    const browserLang = navigator.language || navigator.userLanguage || '';
    const preferredLang = browserLang.split('-')[0].toLowerCase();
    if (!preferredLang || preferredLang === currentLang) return;

    const target = targets.find((item) => item.lang === preferredLang);
    if (!target) return;

    const localeCopy = copy[currentLang] || copy.zh;
    titleEl.textContent = localeCopy.title;
    bodyEl.textContent = localeCopy.body(target.label);

    const primaryLink = document.createElement('a');
    primaryLink.href = target.href;
    primaryLink.textContent = localeCopy.cta(target.label);
    primaryLink.className =
      'inline-flex items-center rounded-full bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200';
    actionsEl.appendChild(primaryLink);

    root.classList.remove('hidden');

    closeButton?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'true');
      root.remove();
    });
  })();
